generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

//remove url comment while applying migrations

datasource db {
  provider = "postgresql"
  //url      = env("DATABASE_URL")
}

model User {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
  balance  Int    @default(0)
  //orders   Order[]
  deleted  Boolean @default(false)
}

model Stock {
  id      Int @id @default(autoincrement())
  title   String 
  symbol  String
  imageurl   String
  market  String
  deleted  Boolean @default(false)
}

model Order {
  orderId        String @id

  side           String
  type           String

  price          Int
  quantity       Int
  filledQuantity Int

  status         String 

  userId         String
 // user      User @relation(fields: [userId], references: [id]) 

  stockSymbol     String

  deleted          Boolean  @default(false)

  createdAt        DateTime @default(now())
  @@index([userId])
}

model Fill {
  id               Int      @id @default(autoincrement())

  makerID          String
  takerID          String

  makerOrderID     String
  takerOrderID     String

  quantity         Int
  market           String
  price            Int

  createdAt        DateTime @default(now())

  @@index([makerOrderID])
  @@index([takerOrderID])
  @@index([market])
  @@index([createdAt])
}

model Contracts {
  id                String @id @default(uuid())
  contract_quantity Int
  avg_price         Int
  collateral        Int
  realizedProfit    Int
  realizedLoss      Int
  stockSymbol       String
  userId            String
}


generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String     @id @default(uuid())
  username String  @unique
  password String
  balance  Int     @default(0)
  deleted  Boolean @default(false)
  role     String  @default("client")
}

model Stock {
  id      String     @id @default(uuid())
  title   String
  symbol  String
  market  String
  deleted Boolean @default(false)
}

model Order {
  side           String
  type           String
  price          Int
  quantity       Int
  filledQuantity Int
  status         String
  userId         String
  deleted        Boolean  @default(false)
  createdAt      DateTime @default(now())
  orderId        String   @id
  symbol         String
  market         String
  @@index([userId])
}

model Fill {
  id           String      @id @default(uuid())
  makerSide    String
  takerSide    String
  makerID      String
  takerID      String
  makerOrderID String
  takerOrderID String
  quantity     Int
  symbol       String
  market       String
  price        Int
  createdAt    DateTime

  @@index([makerOrderID])
  @@index([takerOrderID])
  @@index([symbol], map: "Fill_market_idx")
  @@index([createdAt])
}

model Contracts {
  id                String @id @default(uuid())
  contract_quantity Int
  avg_price         Int
  collateral        Int
  realizedProfit    Int
  realizedLoss      Int
  stockSymbol       String
  userId            String
}

model CandleStick {
  id    String @id @default(uuid())
  open  Int
  close Int
  high  Int
  low   Int
  time  DateTime
}

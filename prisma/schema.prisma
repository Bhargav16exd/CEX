// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

//remove url comment while applying migrations

datasource db {
  provider = "postgresql"
  //url      = env("DATABASE_URL")
}

model User {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
  balance  Int    @default(0)
  orders   Order[]
  deleted  Boolean @default(false)
}

model Stock {
  id      Int @id @default(autoincrement())
  title   String 
  symbol  String
  imageurl   String
  market  String
  orders  Order[]
  deleted  Boolean @default(false)
}

model Order {
  id             String @id

  side           String
  type           String

  price          Int
  quantity       Int
  filledQuantity Int

  status         String 

  userId         Int
  buyerUser      User @relation(fields: [userId], references: [id]) 

  stockId        Int
  stock          Stock @relation(fields: [stockId], references: [id])

  deleted          Boolean  @default(false)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([stockId])
}

model Fill {
  id               Int      @id @default(autoincrement())

  makerID          String
  takerID          String

  makerOrderID     String
  takerOrderID     String

  quantity         Int
  market           String
  price            Int

  createdAt        DateTime @default(now())

  @@index([makerOrderID])
  @@index([takerOrderID])
  @@index([market])
  @@index([createdAt])
}